{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fenforce-frontend-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../packages/twenty-front/build-convex",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
