{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": { "#fixtures/*": ["./fixtures/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", ".storybook/*.ts"],
  "exclude": ["node_modules", "artifacts", ".stryker-tmp"]
}
