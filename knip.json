{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["packages/twenty-docs", "packages/twenty-apps/**"],
  "rules": {
    "binaries": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "warn",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "optionalPeerDependencies": "warn",
    "types": "warn",
    "unlisted": "warn",
    "unresolved": "warn"
  },
  "workspaces": {
    "packages/twenty-server": {
      "entry": [
        "src/main.ts",
        "src/command/command.ts",
        "src/queue-worker/queue-worker.ts",
        "src/database/scripts/*.ts",
        "src/database/clickhouse/migrations/run-migrations.ts",
        "src/database/clickhouse/seeds/run-seeds.ts",
        "src/instrument.ts",
        "lingui.config.ts",
        "scripts/**/*.ts",
        "**/*.spec.ts",
        "**/*.integration-spec.ts",
        "src/database/typeorm/core/legacy-typeorm-migrations-do-not-add/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
      "jest": [
        "jest.config.mjs",
        "jest-integration.config.ts",
        "jest-integration-secure.config.ts"
      ],
      "ignore": [
        "src/**/constants/seed-project/**",
        "**/*.workspace-entity.ts",
        "src/engine/core-modules/logic-function/logic-function-resource/constants/**",
        "src/database/commands/upgrade-version-command/**",
        "src/engine/metadata-modules/*/constants/standard-*-names.ts",
        "src/engine/metadata-modules/*/constants/standard-*-titles.ts"
      ],
      "ignoreDependencies": ["@types/psl"]
    },
    "packages/twenty-front": {
      "entry": [
        "src/convex.tsx",
        "src/**/graphql/**/*.{ts,tsx}",
        "src/modules/geo-map/graphql-query/*.{ts,tsx}",
        "lingui.config.ts",
        "lingui.convex.config.ts",
        "nyc.config.cjs",
        "vite.convex.config.ts"
      ],
      "vitest": ["vitest.config.ts", "vite.unit.config.ts"],
      "graphql-codegen": [
        "codegen.cjs",
        "codegen-admin.cjs",
        "codegen-metadata.cjs"
      ],
      "ignore": ["src/locales/generated/**", ".eloqnt/config.ts"],
      "ignoreDependencies": [
        "@babel/plugin-transform-export-namespace-from",
        "@babel/preset-react",
        "@babel/preset-typescript",
        "react-router",
        "rollup-plugin-node-polyfills"
      ]
    },
    "packages/twenty-ui": {
      "entry": ["scripts/**/*.ts", "docs/**/*.ts"],
      "ignore": ["src/styles/abstracts/**"],
      "ignoreDependencies": ["@swc/core"]
    }
  }
}
