{
  "name": "twenty-client-sdk",
  "version": "2.44.0",
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "test:coverage": "bunx vite-plus run twenty-client-sdk#test -- --coverage",
    "test:watch": "bunx vite-plus run --no-cache twenty-client-sdk#test -- --watch",
    "lint:ci": "bunx vite-plus run twenty-client-sdk#lint",
    "build:command": "bunx rimraf dist && bunx vite build && bunx vite build -c vite.metadata.config.ts && node node_modules/typescript/bin/tsc -p tsconfig.lib.json --declaration --emitDeclarationOnly --noEmit false --outDir dist --rootDir src && bunx tsc-alias -p tsconfig.lib.json --outDir dist",
    "generate-metadata-client:command": "tsx scripts/generate-metadata-client.ts",
    "test:command": "bunx vitest run --config vitest.config.ts",
    "test:ci:command": "bunx vitest run --config vitest.config.ts",
    "set-local-version": "bun -e 'const fs = require(\"fs\"); const version = process.argv[1]; if (!version) throw new Error(\"releaseVersion required\"); const pkg = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")); pkg.version = version; fs.writeFileSync(\"package.json\", JSON.stringify(pkg, null, 2) + \"\\n\");'",
    "typecheck:command": "tsgo -p tsconfig.json",
    "lint:command": "bunx oxlint -c .oxlintrc.json . && (bunx oxfmt --check . || (echo 'ERROR: oxfmt formatting check failed! Fix with: bun run lint:fix:command' && false))",
    "lint:fix": "bunx oxlint --fix -c .oxlintrc.json . && bunx oxfmt .",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata.mjs",
      "require": "./dist/metadata.cjs"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "import": "./dist/rest.mjs",
      "require": "./dist/rest.cjs"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate.mjs",
      "require": "./dist/generate.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "metadata": [
        "dist/metadata/index.d.ts"
      ],
      "rest": [
        "dist/rest/index.d.ts"
      ],
      "generate": [
        "dist/generate/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@genql/runtime": "^2.10.0",
    "esbuild": "^0.28.1",
    "graphql": "^16.8.1",
    "lodash": "^4.17.21",
    "prettier": "^3.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "tsc-alias": "^1.8.16",
    "twenty-shared": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^24.5.0"
  }
}
