{
  "name": "@twentyhq/companion",
  "productName": "Twenty",
  "version": "0.1.0",
  "private": true,
  "description": "See upcoming meetings, record calls, and open transcripts and summaries in your Twenty workspace.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": "^24.5.0"
  },
  "scripts": {
    "test:ci": "bunx vite-plus run twenty-companion#test -- --coverage",
    "test:coverage": "bunx vite-plus run twenty-companion#test -- --coverage",
    "test:watch": "bunx vite-plus run --no-cache twenty-companion#test -- --watch",
    "dev": "bun run native:setup && bun run lingui:compile && node scripts/dev.mjs",
    "build:command": "bun run lingui:compile && node scripts/build.mjs",
    "start": "bun run native:setup && electron .",
    "preview": "bun run lingui:compile && vite --host 127.0.0.1 --port 4317",
    "typecheck:command": "tsc --noEmit",
    "test:command": "vitest run --passWithNoTests",
    "package": "bun run native:setup && bun run lingui:compile && node scripts/package.mjs",
    "package:archive": "bun run native:setup && bun run lingui:compile && node scripts/archive.mjs",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "native:setup": "node scripts/setup-native.mjs",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@lingui/core": "6.9.0",
    "@recallai/desktop-sdk": "2.0.36",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "twenty-ui": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "@electron/packager": "^20.3.0",
    "@lingui/cli": "6.9.0",
    "@lingui/conf": "6.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "sass": "^1.105.1",
    "typescript": "next",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  }
}
