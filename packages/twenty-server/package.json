  "scripts": {
    "test:coverage": "bunx vite-plus run twenty-server#test -- --coverage --coverageReporters=lcov --coverageReporters=text",
    "test:watch": "bunx vite-plus run --no-cache twenty-server#test -- --watch",
    "start:prod": "node dist/main",
    "command:prod": "node dist/command/command",
    "worker:prod": "node dist/queue-worker/queue-worker",
    "database:init:prod": "node dist/database/scripts/setup-db.js && bun run database:migrate:prod --force --include-slow",
    "database:migrate:prod": "node dist/command/command run-instance-commands",
    "clickhouse:migrate:prod": "node dist/database/clickhouse/migrations/run-migrations.js",
    "command:prod:background": "./scripts/command-background.sh start",
    "command:prod:background:logs": "./scripts/command-background.sh logs",
    "command:prod:background:stop": "./scripts/command-background.sh stop",
    "typeorm": "../../node_modules/typeorm/.bin/typeorm",
    "build:command": "rimraf dist && nest build --path ./tsconfig.build.json && mkdir -p dist/assets/twenty-client-sdk && cp ../twenty-client-sdk/package.json dist/assets/twenty-client-sdk/ && cp -r ../twenty-client-sdk/dist dist/assets/twenty-client-sdk/dist",
    "test:integration:secure": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=6144\" bunx jest --config ./jest-integration-secure.config.ts --logHeapUsage",
    "test:integration": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=6144\" bunx jest --config ./jest-integration.config.ts --logHeapUsage",
    "test:integration:with-db-reset": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=12288\" bunx vite-plus run twenty-server#database:reset > reset-logs.log && NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=6144\" bunx jest --config ./jest-integration.config.ts --logHeapUsage",
    "test:ci:command": "bunx jest --config ./jest.config.mjs --ci --runInBand",
    "build:packageJson": "bunx tsgo -p tsconfig.json --outDir dist && cp package.json dist/package.json",
    "typecheck:command": "tsgo -p tsconfig.json",
    "knip": "cd ../.. && bunx knip --workspace packages/twenty-server",
    "start:command": "rimraf dist && NODE_ENV=development nest start --watch",
    "start:ci": "NODE_ENV=development nest start",
    "start:ci-if-needed:command": "bun -e 'fetch(\"http://localhost:3000/healthz\").then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))' && echo 'Server already running' || (nohup bunx nest start &)",
    "start:debug:command": "rimraf dist && NODE_ENV=development nest start --watch --debug",
    "reset:env": "cp .env.example .env",
    "reset:env:e2e-testing-server": "cp .env.e2e-testing-server .env",
    "command:command": "node dist/command/command.js",
    "command-no-deps": "node dist/command/command.js",
    "worker:command": "NODE_ENV=development nest start --watch --entryFile queue-worker/queue-worker",
    "ts-node:command": "bunx ts-node",
    "ts-node-no-deps": "bunx ts-node",
    "ts-node-no-deps-transpile-only": "bunx ts-node --transpile-only",
    "lint:command": "bunx oxlint --type-aware -c .oxlintrc.json src/ test/ && bunx oxfmt --check src/ test/",
    "lint:ci:command": "bunx oxlint --type-aware -c .oxlintrc.json src/ test/ && bunx oxfmt --check src/ test/",
    "lint:fix:command": "bunx oxlint --type-aware --fix -c .oxlintrc.json src/ test/ && bunx oxfmt src/ test/",
    "lint:diff-with-main:command": "FILES=$(git diff --name-only --relative --diff-filter=d main...HEAD -- src/ test/ | grep -E '\\.(ts|tsx)$'); [ -z \"$FILES\" ] && echo 'No changed files.' || (bunx oxlint --type-aware -c .oxlintrc.json $FILES && (bunx oxfmt --check $FILES || (echo 'ERROR: oxfmt formatting check failed! Fix with: bun run lint:diff-with-main:fix' && false)))",
    "lint:diff-with-main:fix:command": "FILES=$(git diff --name-only --relative --diff-filter=d main...HEAD -- src/ test/ | grep -E '\\.(ts|tsx)$'); [ -z \"$FILES\" ] && echo 'No changed files.' || (bunx oxlint --type-aware --fix -c .oxlintrc.json $FILES && bunx oxfmt $FILES)",
    "test:command": "bunx jest --config jest.config.mjs --silent",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/.bin/jest --runInBand",
    "jest": "bunx jest",
    "database:migrate:command": "node dist/command/command.js run-instance-commands --force",
    "database:init:command": "node dist/database/scripts/setup-db.js && bun run database:migrate:command --include-slow",
    "database:migrate:generate:command": "node dist/command/command.js generate:instance-command",
    "generate:integration-test": "bun run ts-node-no-deps -- ./test/integration/graphql/codegen/index.ts",
    "database:reset:command": "bun run database:reset:seed:command",
    "database:reset:no-seed:command": "node dist/database/scripts/truncate-clickhouse.js && node dist/database/scripts/truncate-db.js && bun run database:init:command && bun run command-no-deps -- cache:flush",
    "database:reset:seed:command": "node dist/database/scripts/truncate-clickhouse.js && node dist/database/scripts/truncate-db.js && bun run database:init:command && bun run command-no-deps -- cache:flush && bun run command-no-deps -- workspace:seed:dev",
    "clickhouse:migrate": "bun run ts-node-no-deps-transpile-only -- src/database/clickhouse/migrations/run-migrations.ts",
    "clickhouse:seed": "bun run ts-node-no-deps-transpile-only -- src/database/clickhouse/seeds/run-seeds.ts",
    "lingui:extract:command": "lingui extract --overwrite --clean",
    "lingui:compile:command": "lingui compile --typescript",
    "version:bump": "bunx tsx scripts/bump-version.ts",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch"
  },
