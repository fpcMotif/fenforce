{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../.cache/tsc",
    "composite": true,
    "declaration": true,
    // tsconfig.json sets noEmit for the typecheck target; the build's
    // declaration emit must undo it.
    "noEmit": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.spec.tsx", "**/*.test.tsx"]
}
