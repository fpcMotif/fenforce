{
  "name": "twenty-front",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:ci": "bunx vite-plus run twenty-front#lint",
    "fmt:ci": "bunx vite-plus run twenty-front#fmt",
    "test:ci": "vp test run --config vite.unit.config.ts --maxWorkers=1 --coverage",
    "test:coverage": "vp test run --config vite.unit.config.ts --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vp test --config vite.unit.config.ts --watch",
    "i18n:convex": "lingui extract --config lingui.convex.config.ts && lingui compile --config lingui.convex.config.ts --strict",
    "build:convex": "bun run i18n:convex && vp build --config vite.convex.config.ts",
    "start:convex": "bun run i18n:convex && vp dev --config vite.convex.config.ts",
    "check:convex-preview": "bun run i18n:convex && tsgo -p tsconfig.convex.json --noEmit && bunx oxlint --type-aware -c .oxlintrc.json src/convex.tsx src/pages/convex-preview && bunx oxfmt --check src/convex.tsx src/pages/convex-preview && vp test run src/pages/convex-preview/__tests__ --config vite.unit.config.ts --maxWorkers=1",
    "build:command": "bun run i18n:convex && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vp build",
    "build:sourcemaps:command": "bun run i18n:convex && NODE_ENV=production VITE_BUILD_SOURCEMAP=true NODE_OPTIONS=--max-old-space-size=8192 vp build",
    "start:prod": "NODE_ENV=production bunx serve -s build",
    "tsup": "bunx tsup",
    "serve": "bunx serve -s build",
    "start:command": "bun run i18n:convex && vp dev",
    "dev:portless": "bun run i18n:convex && portless fenforce-front sh -c 'exec vp dev --port \"$PORT\" --host 127.0.0.1'",
    "preview": "vp preview --port 3001 --open",
    "preview:portless": "portless fenforce-front sh -c 'exec vp preview --port \"$PORT\" --host 127.0.0.1'",
    "reset:env": "cp .env.example .env",
    "typecheck:command": "bun run i18n:convex && tsgo -p tsconfig.json",
    "knip": "cd ../.. && bunx knip --workspace packages/twenty-front",
    "lint:command": "bunx oxlint --type-aware -c .oxlintrc.json src/ && bunx oxfmt --check src/",
    "lint:fix": "bunx oxlint --type-aware --fix -c .oxlintrc.json src/ && bunx oxfmt src/",
    "lint:i18n": "bunx eloqnt lint",
    "lint:diff-with-main:command": "FILES=$(git diff --name-only --relative --diff-filter=d main...HEAD -- src/ | grep -E '\\.(ts|tsx)$'); [ -z \"$FILES\" ] && echo 'No changed files.' || (bunx oxlint --type-aware -c .oxlintrc.json $FILES && (bunx oxfmt --check $FILES || (echo 'ERROR: oxfmt formatting check failed! Fix with: bun run lint:diff-with-main:fix' && false)))",
    "lint:diff-with-main:fix": "FILES=$(git diff --name-only --relative --diff-filter=d main...HEAD -- src/ | grep -E '\\.(ts|tsx)$'); [ -z \"$FILES\" ] && echo 'No changed files.' || (bunx oxlint --type-aware --fix -c .oxlintrc.json $FILES && bunx oxfmt $FILES)",
    "fmt:command": "bunx oxfmt --check src",
    "fmt:fix": "bunx oxfmt src",
    "test:command": "vp test run --config vite.unit.config.ts --silent",
    "storybook:build:command": "NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:build:docs:command": "STORYBOOK_SCOPE=ui-docs NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:build:modules:command": "STORYBOOK_SCOPE=modules NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:build:pages:command": "STORYBOOK_SCOPE=pages NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:build:performance:command": "STORYBOOK_SCOPE=performance NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:serve:dev:command": "storybook dev --port 6006",
    "storybook:serve:dev:docs:command": "STORYBOOK_SCOPE=ui-docs storybook dev --port 6006",
    "storybook:serve:dev:modules:command": "STORYBOOK_SCOPE=modules storybook dev --port 6006",
    "storybook:serve:dev:pages:command": "STORYBOOK_SCOPE=pages storybook dev --port 6006",
    "storybook:serve:dev:performance:command": "STORYBOOK_SCOPE=performance storybook dev --port 6006",
    "storybook:serve:static:command": "bunx http-server storybook-static -a=localhost --port=6006 --silent=true",
    "storybook:serve:static:docs:command": "STORYBOOK_SCOPE=ui-docs bunx http-server storybook-static -a=localhost --port=6006 --silent=true",
    "storybook:serve:static:modules:command": "STORYBOOK_SCOPE=modules bunx http-server storybook-static -a=localhost --port=6006 --silent=true",
    "storybook:serve:static:pages:command": "STORYBOOK_SCOPE=pages bunx http-server storybook-static -a=localhost --port=6006 --silent=true",
    "storybook:serve:static:performance:command": "STORYBOOK_SCOPE=performance bunx http-server storybook-static -a=localhost --port=6006 --silent=true",
    "storybook:coverage": "bunx nyc report --reporter=lcov --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "storybook:coverage:text": "bunx nyc report --reporter=text --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "storybook:coverage:docs": "STORYBOOK_SCOPE=ui-docs bunx nyc report --reporter=lcov --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "storybook:coverage:modules": "STORYBOOK_SCOPE=modules bunx nyc report --reporter=lcov --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "storybook:coverage:pages": "STORYBOOK_SCOPE=pages bunx nyc report --reporter=lcov --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "storybook:coverage:performance": "STORYBOOK_SCOPE=performance bunx nyc report --reporter=lcov --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "storybook:test": "vp test run --config vitest.config.ts --project=storybook --coverage",
    "storybook:test:docs": "STORYBOOK_SCOPE=ui-docs vp test run --config vitest.config.ts --project=storybook --coverage",
    "storybook:test:modules": "STORYBOOK_SCOPE=modules vp test run --config vitest.config.ts --project=storybook --coverage",
    "storybook:test:pages": "STORYBOOK_SCOPE=pages vp test run --config vitest.config.ts --project=storybook --coverage",
    "storybook:test:performance": "STORYBOOK_SCOPE=performance vp test run --config vitest.config.ts --project=storybook --coverage",
    "storybook:test:no-coverage": "vp test run --config vitest.config.ts --project=storybook",
    "storybook:test:no-coverage:docs": "STORYBOOK_SCOPE=ui-docs vp test run --config vitest.config.ts --project=storybook",
    "storybook:test:no-coverage:modules": "STORYBOOK_SCOPE=modules vp test run --config vitest.config.ts --project=storybook",
    "storybook:test:no-coverage:pages": "STORYBOOK_SCOPE=pages vp test run --config vitest.config.ts --project=storybook",
    "storybook:test:no-coverage:performance": "STORYBOOK_SCOPE=performance vp test run --config vitest.config.ts --project=storybook",
    "graphql:generate": "bunx dotenv graphql-codegen -- --config=codegen.cjs",
    "graphql:generate:data": "bunx dotenv graphql-codegen -- --config=codegen.cjs",
    "graphql:generate:metadata": "bunx dotenv graphql-codegen -- --config=codegen-metadata.cjs",
    "graphql:generate:admin": "bunx dotenv graphql-codegen -- --config=codegen-admin.cjs",
    "mock:generate": "bunx dotenv -- bunx vite-node scripts/generate-mock-data.ts",
    "lingui:extract:command": "lingui extract --overwrite --clean",
    "lingui:compile:command": "lingui compile --typescript",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch"
  },
  "engines": {
    "node": "^24.5.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "msw": {
    "workerDirectory": "public"
