{
  "name": "twenty-agent-skills",
  "version": "0.1.0",
  "description": "Harness-agnostic Agent Skills for creating, developing, operating, and publishing Twenty apps.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "test:ci": "bunx vite-plus run twenty-agent-skills#test",
    "test:coverage": "bunx vite-plus run twenty-agent-skills#test",
    "test:watch": "bunx vite-plus run --no-cache twenty-agent-skills#test",
    "build:command": "node ./scripts/build.js",
    "validate": "node ./scripts/validate-source.js && node ./scripts/build.js && node ./scripts/validate-distribution.js",
    "test:command": "node --test ./scripts/__tests__/*.spec.js",
    "verify:install": "node ./scripts/verify-install.js",
    "setup:mcp": "bash ./scripts/setup-mcp.sh",
    "fmt:command": "prettier . --check --cache --cache-location ../../.cache/prettier/packages/twenty-agent-skills --cache-strategy metadata",
    "fmt:ci": "prettier . --check --cache --cache-location ../../.cache/prettier/packages/twenty-agent-skills --cache-strategy metadata",
    "fmt:fix": "prettier . --write --cache --cache-location ../../.cache/prettier/packages/twenty-agent-skills --cache-strategy metadata"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "AGENTS.md",
    "README.md",
    "assets",
    "references",
    "skills",
    "scripts/setup-mcp.sh"
  ],
  "engines": {
    "node": "^24.5.0"
  }
}
