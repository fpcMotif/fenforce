{
  "name": "twenty-website",
  "private": true,
  "scripts": {
    "test:ci": "bunx vite-plus run twenty-website#test -- --ci --maxWorkers=1 --coverage",
    "test:coverage": "bunx vite-plus run twenty-website#test -- --coverage --coverageReporters=lcov --coverageReporters=text",
    "test:watch": "bunx vite-plus run --no-cache twenty-website#test -- --watch",
    "lint:ci": "bunx vite-plus run twenty-website#lint",
    "dev": "bunx next dev --port 3002",
    "build:command": "bunx next build",
    "start": "bunx next start --port 3002",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env prod",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck:command": "bunx tsc -p tsconfig.json --noEmit",
    "test:command": "bunx jest --config=jest.config.mjs",
    "lint:command": "node scripts/check-conventions.mjs && bunx oxlint -c .oxlintrc.json . && bunx oxfmt --check .",
    "lint:fix:command": "bunx oxfmt .",
    "lingui:extract": "lingui extract --overwrite --clean",
    "lingui:compile": "lingui compile --typescript",
    "typecheck:watch": "bunx tsc -p tsconfig.json --noEmit --watch"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@base-ui/react": "^1.8.0",
    "@calcom/embed-react": "^1.5.3",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@tabler/icons-react": "^3.49.0",
    "@wyw-in-js/babel-preset": "^2.5.1",
    "@wyw-in-js/transform": "^2.5.1",
    "lodash.isempty": "^4.4.0",
    "next": "^16.4.0",
    "next-with-linaria": "^1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
    "twenty-shared": "workspace:*",
    "twenty-ui": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "next",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@lingui/cli": "^6.9.0",
    "@lingui/conf": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/swc-plugin": "^6.7.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash.isempty": "^4.4.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jest-environment-jsdom": "30.5.2",
    "jest": "30.5.2",
    "oxlint": "1.87.0",
    "wrangler": "^4.149.0"
  }
}
