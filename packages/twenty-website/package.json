{
  "name": "twenty-website",
  "private": true,
  "scripts": {
    "test:ci": "bunx vite-plus run twenty-website#test -- --ci --maxWorkers=1 --coverage",
    "test:coverage": "bunx vite-plus run twenty-website#test -- --coverage --coverageReporters=lcov --coverageReporters=text",
    "test:watch": "bunx vite-plus run --no-cache twenty-website#test -- --watch",
    "lint:ci": "bunx vite-plus run twenty-website#lint",
    "dev": "bunx next dev --port 3002",
    "build:command": "bunx next build",
    "start": "bunx next start --port 3002",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env prod",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck:command": "bunx tsc -p tsconfig.json --noEmit",
    "test:command": "bunx jest --config=jest.config.mjs",
    "lint:command": "node scripts/check-conventions.mjs && bunx oxlint -c .oxlintrc.json . && bunx oxfmt --check .",
    "lint:fix:command": "bunx oxfmt .",
    "lingui:extract": "lingui extract --overwrite --clean",
    "lingui:compile": "lingui compile --typescript",
    "typecheck:watch": "bunx tsc -p tsconfig.json --noEmit --watch"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "@base-ui/react": "^1.3.0",
    "@calcom/embed-react": "^1.5.3",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@lingui/core": "^5.1.2",
    "@lingui/react": "^5.1.2",
    "@lottiefiles/dotlottie-react": "^0.18.10",
    "@tabler/icons-react": "^3.41.1",
    "@wyw-in-js/babel-preset": "^0.8.1",
    "@wyw-in-js/transform": "^0.8.1",
    "lodash.isempty": "^4.4.0",
    "next": "^16.2.6",
    "next-with-linaria": "^1.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "stripe": "^20.3.1",
    "three": "^0.184.0",
    "twenty-shared": "workspace:*",
    "twenty-ui": "workspace:*",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@babel/plugin-transform-export-namespace-from": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@lingui/cli": "^5.1.2",
    "@lingui/conf": "5.1.2",
    "@lingui/format-po": "5.1.2",
    "@lingui/swc-plugin": "^5.11.0",
    "@opennextjs/cloudflare": "^1.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.isempty": "^4.4.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jest-environment-jsdom": "30.0.0-beta.3",
    "jest": "29.7.0",
    "wrangler": "^4.0.0"
  }
}
