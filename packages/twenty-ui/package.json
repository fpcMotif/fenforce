      ],
      "utilities": [
        "dist/utilities/index.d.ts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  }
