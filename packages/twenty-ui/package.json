      "require": "./dist/theme.cjs"
    },
    "./utilities": {
      "types": "./dist/utilities/index.d.ts",
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "assets": [
        "dist/assets/index.d.ts"
      ],
      "components": [
        "dist/components/index.d.ts"
      ],
      "components/code-editor": [
