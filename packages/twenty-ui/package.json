{
  "name": "twenty-ui",
  "version": "2.44.0",
  "description": "Twenty's shared React UI component library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twentyhq/twenty.git",
    "directory": "packages/twenty-ui"
  },
  "homepage": "https://twenty.com",
  "bugs": "https://github.com/twentyhq/twenty/issues",
  "keywords": [
    "twenty",
    "ui",
    "react",
    "components",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "style": "./dist/style.css",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "storybook": "^10.4.6",
    "@types/node": "^24.0.0",
    "vite": "^8.0.0",
    "@argos-ci/storybook": "6.2.3",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@prettier/sync": "^0.5.2",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook-community/storybook-addon-cookie": "^5.0.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@swc/core": "^1.15.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.28.1",
    "glob": "^11.1.0",
    "jsdom": "^30.0.1",
    "monaco-editor": "0.52.2",
    "prettier": "^3.1.1",
    "react": "^19.2.0",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^19.2.0",
    "sass": "^1.83.0",
    "sass-embedded": "^1.83.0",
    "size-limit": "^12.1.0",
    "slash": "^5.1.0",
    "storybook-addon-pseudo-states": "^10.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.10.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-sass-dts": "^1.3.31",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@base-ui/utils": "0.4.0",
    "@sniptt/guards": "^0.2.0",
    "@tabler/icons-react": "^3.31.0",
    "clsx": "^2.1.1",
    "type-fest": "^4.10.1",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": ">= 0.25.0 < 1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "lint:ci": "bunx vite-plus run twenty-ui#lint",
    "fmt:ci": "bunx vite-plus run twenty-ui#fmt",
    "test:ci": "bunx vite-plus run twenty-ui#test -- --coverage",
    "test:coverage": "bunx vite-plus run twenty-ui#test -- --coverage",
    "storybook:coverage:text": "bunx nyc report --reporter=text --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "build:command": "bunx vite build",
    "check:ownership:command": "cd ../.. && bunx tsx packages/twenty-ui/scripts/checkModuleOwnership.ts",
    "generateTokens": "cd ../.. && bunx tsx packages/twenty-ui/scripts/generateThemeTokens.ts",
    "generate:check": "cd ../.. && bunx tsx packages/twenty-ui/scripts/generateThemeTokens.ts --check",
    "generateBarrels": "cd ../.. && bunx tsx packages/twenty-ui/scripts/generateBarrels.ts",
    "generateIconDictionary": "cd ../.. && bunx tsx packages/twenty-ui/scripts/generateIconDictionary.ts",
    "checkIconDictionary": "cd ../.. && bunx tsx packages/twenty-ui/scripts/generateIconDictionary.ts --check",
    "build:individual:command": "bunx vite build -c vite.config.individual.ts",
    "size:command": "bunx size-limit",
    "size:why:command": "bunx size-limit --why",
    "pack-size:command": "tsx scripts/checkPackSize.ts",
    "test:package:command": "tsx scripts/checkOptionalDependencies.ts && tsx scripts/checkThemeExports.ts",
    "clean": "rimraf dist",
    "set-local-version": "bun -e 'const fs = require(\"fs\"); const version = process.argv[1]; if (!version) throw new Error(\"releaseVersion required\"); const pkg = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")); pkg.version = version; fs.writeFileSync(\"package.json\", JSON.stringify(pkg, null, 2) + \"\\n\");'",
    "lint:command": "bunx oxlint -c .oxlintrc.json . && (bunx oxfmt --check . || (echo 'ERROR: oxfmt formatting check failed! Fix with: bun run lint:fix:command' && false))",
    "fmt:command": "bunx oxfmt --check src",
    "fmt:fix": "bunx oxfmt src",
    "test:command": "bunx vitest run --project unit",
    "test:watch:command": "bunx vitest --project unit",
    "typecheck:command": "tsgo -p tsconfig.json",
    "knip": "cd ../.. && bunx knip --workspace packages/twenty-ui",
    "storybook:build:command": "NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:build:test": "NODE_OPTIONS='--max-old-space-size=10240' storybook build --test",
    "storybook:build:docs": "STORYBOOK_DOCS=true NODE_OPTIONS='--max-old-space-size=10240' storybook build --disable-telemetry",
    "storybook:index": "mkdir -p ../../.cache/ui-docs && storybook index --output-file ../../.cache/ui-docs/storybook-index.json --disable-telemetry",
    "storybook:serve:dev:command": "bunx storybook dev --port 6008",
    "storybook:serve:static:command": "bunx http-server storybook-static -a=localhost --port=6008 --silent",
    "storybook:serve:static:test:command": "bunx http-server storybook-static -a=localhost --port=6008 --silent",
    "storybook:test": "vitest run --coverage --project storybook",
    "storybook:test:no-coverage": "vitest run --project storybook",
    "storybook:visual-diff:command": "bash scripts/visual-diff.sh",
    "storybook:coverage": "bunx nyc report --reporter=lcov --reporter=text-summary -t coverage/storybook --report-dir coverage/storybook --check-coverage=true --cwd=.",
    "lint:fix": "bunx oxlint --fix -c .oxlintrc.json . && bunx oxfmt .",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/individual",
    "!dist/individual/**",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./theme-light.css": "./dist/theme-light.css",
    "./theme-dark.css": "./dist/theme-dark.css",
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "import": "./dist/assets.mjs",
      "require": "./dist/assets.cjs"
    },
    "./components": {
