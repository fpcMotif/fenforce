      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "primitives": [
        "dist/primitives/index.d.ts"
      ],
      "primitives/accessibility": [
        "dist/primitives/accessibility/index.d.ts"
      ],
      "primitives/data-display": [
        "dist/primitives/data-display/index.d.ts"
      ],
      "primitives/feedback": [
