{
  "name": "create-twenty-app",
  "version": "2.44.0",
  "description": "Command-line interface to create Twenty application",
  "main": "dist/cli.cjs",
  "bin": "dist/cli.cjs",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "npx rimraf dist && npx vite build"
  },
  "keywords": [
    "twenty",
    "cli",
    "crm",
    "application",
    "development"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "lodash.camelcase": "^4.3.0",
    "lodash.kebabcase": "^4.1.1",
    "lodash.startcase": "^4.4.0",
    "twenty-sdk": "workspace:*",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/lodash.startcase": "^4.4.9",
    "@types/node": "^26.6.4",
    "jest": "30.5.2",
    "jest-environment-node": "^30.5.2",
    "twenty-shared": "workspace:*",
    "twenty-ui": "workspace:*",
    "typescript": "next",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^24.5.0",
    "yarn": "^4.0.2"
  }
}
