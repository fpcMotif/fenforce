{
  "name": "create-twenty-app",
  "version": "2.44.0",
  "description": "Command-line interface to create Twenty application",
  "main": "dist/cli.cjs",
  "bin": "dist/cli.cjs",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "lint:ci": "bunx vite-plus run create-twenty-app#lint",
    "build:command": "bunx vite build",
    "dev:command": "tsx src/cli.ts",
    "start:command": "node dist/cli.cjs",
    "set-local-version": "bun -e 'const fs = require(\"fs\"); const version = process.argv[1]; if (!version) throw new Error(\"releaseVersion required\"); const pkg = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")); pkg.version = version; fs.writeFileSync(\"package.json\", JSON.stringify(pkg, null, 2) + \"\\n\");'",
    "generate-template-lock": "bunx tsx src/scripts/generate-template-lock.ts",
    "typecheck:command": "tsgo -p tsconfig.json",
    "lint:command": "bunx oxlint -c .oxlintrc.json . && (bunx oxfmt --check . || (echo 'ERROR: oxfmt formatting check failed! Fix with: bun run lint:fix:command' && false))",
    "test:command": "bunx jest --config jest.config.mjs --silent",
    "test:ci:command": "bunx jest --config jest.config.mjs --ci --coverage --watchAll=false",
    "lint:fix": "bunx oxlint --fix -c .oxlintrc.json . && bunx oxfmt .",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch",
    "test:watch": "bunx jest --config jest.config.mjs --silent --watch",
    "test:coverage": "bunx jest --config jest.config.mjs --silent --coverage --coverageReporters=lcov --coverageReporters=text"
  },
  "keywords": [
    "twenty",
    "cli",
    "crm",
    "application",
    "development"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "lodash.camelcase": "^4.3.0",
    "lodash.kebabcase": "^4.1.1",
    "lodash.startcase": "^4.4.0",
    "twenty-sdk": "workspace:*",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash.camelcase": "^4.3.7",
    "@types/lodash.kebabcase": "^4.1.7",
    "@types/lodash.startcase": "^4",
    "@types/node": "^20.0.0",
    "jest": "29.7.0",
    "jest-environment-node": "^29.4.1",
    "twenty-shared": "workspace:*",
    "twenty-ui": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^24.5.0"
  }
}
