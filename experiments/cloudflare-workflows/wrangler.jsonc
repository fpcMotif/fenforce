{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fenforce-workflow-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "workflows": [
    {
      "name": "fenforce-approval-spike",
      "binding": "APPROVAL_WORKFLOW",
      "class_name": "ApprovalWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPERIMENT_LEDGER",
        "class_name": "ExperimentLedger",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExperimentLedger"],
    },
  ],
}
